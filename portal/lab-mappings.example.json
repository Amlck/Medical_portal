    "Chloride":         [{ "field": "ag-cl" }],
    "HCO3":             [{ "field": "ag-hco3" }],
    "CO2":              [{ "field": "ag-hco3" }],
    "Total CO2":        [{ "field": "ag-hco3" }],
    "Ca":               [{ "field": "ca-total" }],
    "Calcium":          [{ "field": "ca-total" }],
    "Albumin":          [{ "field": "ag-alb" }, { "field": "ca-alb" }],
    "Alb":              [{ "field": "ag-alb" }, { "field": "ca-alb" }],
    "ALB":              [{ "field": "ag-alb" }, { "field": "ca-alb" }],
